<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cl_entry_register_tutorial_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true"
    android:visibility="gone">

    <!-- 딤 배경 + 일기 작성 영역 투명 구멍(spotlight) -->
    <com.umc.mobile.my4cut.ui.home.TutorialDimView
        android:id="@+id/tutorial_dim_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 일기 작성 카드 하이라이트 -->
    <View
        android:id="@+id/v_highlight_diary"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_dashed_highlight_radius_12" />

    <!-- "포토리 이모티콘과 함께 100자 이내로 하루를 기록해요" 안내 텍스트 -->
    <TextView
        android:id="@+id/tv_tutorial_diary"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/suit_bold"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:gravity="end"
        android:lineSpacingExtra="2dp"
        tools:ignore="HardcodedText" />

    <!-- 일기 작성 카드를 가리키는 화살표 -->
    <ImageView
        android:id="@+id/iv_tutorial_arrow_diary"
        android:layout_width="16dp"
        android:layout_height="27dp"
        android:src="@drawable/ic_tutorial_arrow_home_up"
        android:scaleType="fitXY" />

    <!-- 닫기 버튼 -->
    <LinearLayout
        android:id="@+id/ll_tutorial_close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/close_tutorial" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:fontFamily="@font/suit_medium"
            android:text="닫기"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

    </LinearLayout>

</FrameLayout>
