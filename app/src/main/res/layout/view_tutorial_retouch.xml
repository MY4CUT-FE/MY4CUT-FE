<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cl_retouch_tutorial_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true">

    <com.umc.mobile.my4cut.ui.tutorial.TutorialDimView
        android:id="@+id/tutorial_dim_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- My Space 추가 하이라이트 -->
    <View
        android:id="@+id/v_highlight_add_space"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_dashed_highlight_radius_6" />

    <!-- 첫 번째 Space 카드 하이라이트 -->
    <View
        android:id="@+id/v_highlight_space_card"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_dashed_highlight_radius_21" />

    <!-- Friends 추가 하이라이트 -->
    <View
        android:id="@+id/v_highlight_add_friend"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_dashed_highlight_radius_6" />

    <!-- My Space 추가 -->
    <ImageView
        android:id="@+id/iv_arrow_create"
        android:layout_width="33dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_tutorial_arrow_retouch_left"
        android:scaleType="fitCenter" />

    <!-- 만료 ↑ -->
    <ImageView
        android:id="@+id/iv_arrow_expire"
        android:layout_width="19dp"
        android:layout_height="39dp"
        android:src="@drawable/ic_tutorial_arrow_retouch_up"
        android:scaleType="fitCenter" />

    <!-- 소식 → -->
    <ImageView
        android:id="@+id/iv_arrow_news"
        android:layout_width="42dp"
        android:layout_height="12dp"
        android:src="@drawable/ic_tutorial_arrow_retouch_right"
        android:scaleType="fitCenter" />

    <!-- 인원 ↓ -->
    <ImageView
        android:id="@+id/iv_arrow_members"
        android:layout_width="8dp"
        android:layout_height="35dp"
        android:src="@drawable/ic_tutorial_arrow_retouch_down_straight"
        android:scaleType="fitCenter" />

    <!-- Friends 추가 -->
    <ImageView
        android:id="@+id/iv_arrow_friend"
        android:layout_width="27dp"
        android:layout_height="34dp"
        android:src="@drawable/ic_tutorial_arrow_retouch_down"
        android:scaleType="fitCenter" />

    <!-- 스페이스 생성 -->
    <TextView
        android:id="@+id/tv_tutorial_create"
        android:layout_width="230dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/suit_bold"
        android:gravity="end"
        android:lineSpacingExtra="2dp"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        tools:ignore="HardcodedText" />

    <!-- 스페이스 만료 -->
    <TextView
        android:id="@+id/tv_tutorial_expire"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/suit_bold"
        android:gravity="start"
        android:lineSpacingExtra="2dp"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        tools:ignore="HardcodedText" />

    <!-- 스페이스 소식 -->
    <TextView
        android:id="@+id/tv_tutorial_news"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/suit_bold"
        android:gravity="start"
        android:lineSpacingExtra="2dp"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        tools:ignore="HardcodedText" />

    <!-- 참여 인원 -->
    <TextView
        android:id="@+id/tv_tutorial_members"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/suit_bold"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        tools:ignore="HardcodedText" />

    <!-- 친구 추가 -->
    <TextView
        android:id="@+id/tv_tutorial_friend"
        android:layout_width="270dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/suit_bold"
        android:gravity="end"
        android:lineSpacingExtra="2dp"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        tools:ignore="HardcodedText" />

    <!-- 닫기 -->
    <LinearLayout
        android:id="@+id/ll_tutorial_close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="28dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/close_tutorial" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:fontFamily="@font/suit_medium"
            android:text="닫기"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

    </LinearLayout>

</FrameLayout>