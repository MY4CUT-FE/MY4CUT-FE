<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_album_cover"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="4dp"
        android:layerType="software"
        app:cardCornerRadius="15dp"
        app:strokeWidth="2dp"
        app:strokeColor="#FFEDEA"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/iv_album_cover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:background="@drawable/bg_skeleton_img"
            android:src="@drawable/ic_skeleton_img" />
    </com.google.android.material.card.MaterialCardView>

    <!-- 실제 제목 텍스트: 로딩 끝나기 전엔 안 보임 -->
    <TextView
        android:id="@+id/tv_album_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="ALL"
        android:textSize="13sp"
        android:fontFamily="@font/suit_bold"
        android:visibility="invisible"
        app:layout_constraintTop_toBottomOf="@id/cv_album_cover"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 제목 텍스트 스켈레톤 바 -->
    <View
        android:id="@+id/view_album_title_skeleton"
        android:layout_width="60dp"
        android:layout_height="12dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_skeleton_text_light"
        app:layout_constraintTop_toBottomOf="@id/cv_album_cover"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>