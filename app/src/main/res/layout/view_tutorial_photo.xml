<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cl_retouch_photo_tutorial_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true">

    <com.umc.mobile.my4cut.ui.tutorial.TutorialDimView
        android:id="@+id/tutorial_dim_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:id="@+id/v_highlight_final"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_dashed_highlight_radius_21" />

    <TextView
        android:id="@+id/tv_tutorial_final"
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/suit_medium"
        android:gravity="start"
        android:lineSpacingExtra="2dp"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        tools:ignore="HardcodedText" />

    <ImageView
        android:id="@+id/iv_arrow_final"
        android:layout_width="32dp"
        android:layout_height="26dp"
        android:src="@drawable/ic_tutorial_arrow_photo_right"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:id="@+id/ll_tutorial_close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="28dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/close_tutorial" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:fontFamily="@font/suit_medium"
            android:text="닫기"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

    </LinearLayout>

</FrameLayout>