<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_album_cover"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="14dp"
        app:cardCornerRadius="5dp"
        app:strokeWidth="2dp"
        app:strokeColor="@color/transparent"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/iv_album_cover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="center"
            android:background="@drawable/bg_skeleton_img"
            android:src="@drawable/ic_skeleton_img" />
    </com.google.android.material.card.MaterialCardView>

    <!-- 편집 모드에서만 보이는 삭제 아이콘 (카드 꼭짓점에 절반 걸치게 배치) -->
    <ImageView
        android:id="@+id/iv_delete_photo"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginTop="-10dp"
        android:layout_marginEnd="-10dp"
        android:src="@drawable/ic_delete_photo"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/cv_album_cover"
        app:layout_constraintEnd_toEndOf="@id/cv_album_cover" />

</androidx.constraintlayout.widget.ConstraintLayout>